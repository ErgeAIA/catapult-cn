{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Catapult",
  "version": "0.1.5",
  "identifier": "dev.catapult.launcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run vite",
    "beforeBuildCommand": "npx tsc && npx vite build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Catapult",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJBQTFDNzZBMEE2RUZGQTQKUldTay8yNEthc2VodW5GQU50dmxudTBJR3VkNk0yR1Zxc0czUStWMnY5RmV2TXpLZjhnSnRhRmUK",
      "endpoints": [
        "https://github.com/ErgeAIA/catapult-cn/releases/latest/download/latest.json"
      ]
    }
  }
}